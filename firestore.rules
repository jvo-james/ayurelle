rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function adminDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (adminDocExists() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    // The first administrator is provisioned manually in Firebase Console.
    // Admin membership documents cannot be created or modified by the browser.
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /products/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{reference} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /contact_messages/{messageId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /settings/{documentId} {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
